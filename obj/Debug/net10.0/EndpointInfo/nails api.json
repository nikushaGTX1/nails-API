{
  "openapi": "3.0.4",
  "info": {
    "title": "nails api",
    "version": "1.0"
  },
  "paths": {
    "/api/admin/login": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Sign in and receive an 8-hour admin token",
        "operationId": "AdminLogin",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/admin/session": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "Check whether an admin token is still valid",
        "operationId": "ValidateAdminSession",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/admin/change-password": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Change the admin password and revoke previous sessions",
        "operationId": "ChangeAdminPassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/admin/content": {
      "put": {
        "tags": [
          "Admin"
        ],
        "summary": "Publish text, media references, and website settings",
        "operationId": "PublishSiteContent",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SiteContent"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/admin/media": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Upload an image or video (maximum 100 MB)",
        "operationId": "UploadMedia",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/content": {
      "get": {
        "tags": [
          "Public"
        ],
        "summary": "Get all published website content",
        "operationId": "GetSiteContent",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChangePasswordRequest": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "nullable": true
          },
          "newPassword": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CmsGalleryItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "nullable": true
          },
          "category": {
            "type": "string",
            "nullable": true
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          },
          "position": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CmsLocation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "nullable": true
          },
          "area": {
            "type": "string",
            "nullable": true
          },
          "address": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "nullable": true
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "coordinates": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CmsService": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "nullable": true
          },
          "description": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "nullable": true
          },
          "price": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "SiteContent": {
        "type": "object",
        "properties": {
          "translations": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "nullable": true
          },
          "media": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "nullable": true
          },
          "settings": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "nullable": true
          },
          "services": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CmsService"
            },
            "nullable": true
          },
          "gallery": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CmsGalleryItem"
            },
            "nullable": true
          },
          "locations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CmsLocation"
            },
            "nullable": true
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "tags": [
    {
      "name": "Admin"
    },
    {
      "name": "Public"
    }
  ]
}